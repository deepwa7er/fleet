[Unit]
Description=shutter-relay — live region streaming relay (video-only)
Documentation=https://github.com/deepwa7er/fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shutter-relay
Group=shutter-relay
ExecStart=/usr/local/bin/shutter-relay
Environment=PORT=8125
Environment=BIND=127.0.0.1
# Optional ingest token — set after provisioning:
# Environment=SHUTTER_INGEST_TOKEN=your-token
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
