[Unit]
Description=depot — the fleet's data warehouse
Documentation=https://github.com/deepwa7er/fleet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=depot
Group=depot
# depot reads breakwater's access log out of the journal. journald grants read
# access to the whole journal by group membership, so the service user is in
# `systemd-journal` (provision.sh adds it) — and SupplementaryGroups= must name
# it here too, because systemd builds the process's groups from the unit rather
# than from /etc/group alone.
SupplementaryGroups=systemd-journal
# Creates /var/lib/depot (owned by depot, writable under ProtectSystem=strict)
# for the warehouse DB and the journald read cursor.
StateDirectory=depot
Environment=DEPOT_DB=/var/lib/depot/depot.db
Environment=DEPOT_CURSOR=/var/lib/depot/breakwater.cursor
Environment=DEPOT_ADDR=127.0.0.1:8100
Environment=DEPOT_WEB_DIR=/opt/depot/web
Environment=DEPOT_ACCESS_UNIT=breakwater
Environment=DEPOT_INGEST_INTERVAL_SECS=60
ExecStart=/usr/local/bin/depot serve
Restart=on-failure
RestartSec=2

# Hardening — depot writes only its state dir, reads its web dir and the
# journal, and makes no outbound network calls of its own (emitters push to it).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
