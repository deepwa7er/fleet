[Unit]
Description=Lighthouse service dashboard
Documentation=https://github.com/deepwa7er/lighthouse
# Order after tailscaled so the Tailscale interface/IP exists before we bind.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Unprivileged: systemctl show needs no privilege; journal read comes from the
# systemd-journal supplementary group, configured by deploy.sh.
User=lighthouse
Group=lighthouse
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/lighthouse --config /etc/lighthouse/config.toml
Restart=on-failure
RestartSec=2

# Hardening — the service only reads systemd state and serves static files.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
