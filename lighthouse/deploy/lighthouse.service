[Unit]
Description=Lighthouse service dashboard
Documentation=https://github.com/deepwa7er/lighthouse
# Order after tailscaled so the Tailscale interface/IP exists before we bind.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Unprivileged: systemctl show needs no privilege; journal read comes from the
# systemd-journal supplementary group, configured by deploy.sh.
User=lighthouse
Group=lighthouse
SupplementaryGroups=systemd-journal
ExecStart=/usr/local/bin/lighthouse --config /etc/lighthouse/config.toml
Restart=on-failure
RestartSec=2
# Writable state dir for the health-history SQLite db (/var/lib/lighthouse),
# created and owned by the service user. Required under ProtectSystem=strict.
StateDirectory=lighthouse

# Hardening — the service reads systemd state, serves static files, and writes
# its history db under StateDirectory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
