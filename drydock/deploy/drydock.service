[Unit]
Description=Drydock ticket queue
Documentation=https://github.com/deepwa7er/drydock
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drydock
Group=drydock
# Creates /var/lib/drydock (owned by drydock, writable under ProtectSystem=strict)
# where the SQLite database lives — and which fleet-backup ships to R2.
StateDirectory=drydock
Environment=DRYDOCK_DB=/var/lib/drydock/drydock.db
Environment=DRYDOCK_ADDR=127.0.0.1:8093
Environment=DRYDOCK_WEB_DIR=/opt/drydock/web
Environment=DRYDOCK_STALE_HOURS=3
ExecStart=/usr/local/bin/drydock serve
Restart=on-failure
RestartSec=2

# Hardening — the service only reads its web dir and writes its state dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
