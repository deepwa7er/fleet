# systemd user unit for skiff — the phone web UI for the skiff bridge.
#
# Template: deploy/install-desktop.sh substitutes the placeholders and installs
# this to ~/.config/systemd/user/skiff.service. The wrapper script is installed
# to ~/.config/skiff/skiff-server.sh, and ExecStart references that INSTALLED
# path — not the repo's deploy/ copy — so the unit keeps working however the
# repo moves around.
#
# Type=exec: the wrapper script is the actual service; Restart=always (with
# RestartSec=3) brings the server back when Rails or the tailnet-IP resolution
# fails transiently, and also when a stray external SIGTERM makes puma exit 0
# gracefully — under on-failure a clean exit looks intentional and the unit
# stays dead, which took the site down once (2026-08-10). systemd never
# auto-restarts a stop it initiated itself, so systemctl stop still stops.
# StandardOutput/StandardError go to the repo's log dir, mirroring the macOS
# launchd agent. Everything here is a user unit under $HOME — no sudo.
[Unit]
Description=skiff Rails production server (tailnet, port 8120)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=__SKIFF_DIR__/deploy/skiff-server.sh
Restart=always
RestartSec=3
StandardOutput=append:__SKIFF_DIR__/log/skiff.log
StandardError=append:__SKIFF_DIR__/log/skiff.log

[Install]
WantedBy=default.target
