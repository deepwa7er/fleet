<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent for skiff — the phone web UI for the pi bridge.

  Template: deploy/install-agent.sh substitutes the placeholders and installs
  this to ~/Library/LaunchAgents/com.deepwa7er.skiff.plist. The wrapper script
  is installed to ~/.config/skiff/skiff-server.sh, and the ProgramArguments
  string references that INSTALLED path — not the repo's deploy/ copy — so the
  agent keeps working however the repo moves around.

  Same shape as the other fleet agents: launched through a login fish shell
  (`fish -l -c 'exec …'`) so the daemon gets the full user PATH (tailscale,
  mise) rather than launchd's bare default PATH. The wrapper itself resolves
  the repo's ruby via `mise env`, and KeepAlive restarts the server if it
  dies; RunAtLoad starts it at login.

  Rails logs to STDOUT in production, and launchd captures that here; the
  StandardOut/StandardError paths both point at __SKIFF_DIR__/log/skiff.log.
-->
<plist version="1.0">
<dict>
  <key>KeepAlive</key>
  <true/>
  <key>Label</key>
  <string>com.deepwa7er.skiff</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/fish</string>
    <string>-l</string>
    <string>-c</string>
    <string>exec __SKIFF_DIR__/deploy/skiff-server.mac.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>__SKIFF_DIR__/log/skiff.log</string>
  <key>StandardOutPath</key>
  <string>__SKIFF_DIR__/log/skiff.log</string>
</dict>
</plist>
