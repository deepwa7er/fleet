# systemd user unit for the headless opencode server skiffd's native OpenCode
# adapter talks to.
#
# opencode is itself a session server, so unlike Pi and Muse it runs as its
# own long-lived process rather than being spawned per prompt by skiffd.
# It binds loopback only — skiffd is its sole consumer — on port 4130,
# skiffd's SKIFF_OPENCODE_URL default. The working directory is the projects
# directory (~/code): opencode roots new sessions at its own cwd.
#
# Installed by deploy/install-skiffd.sh. If opencode is absent, the installer
# leaves this unit disabled and skiffd reports that source as unavailable;
# the other harnesses remain usable.
[Unit]
Description=opencode serve (skiff's opencode harness, 127.0.0.1:4130)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/code
ExecStart=%h/.opencode/bin/opencode serve --hostname 127.0.0.1 --port 4130
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
