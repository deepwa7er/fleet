#!/usr/bin/env python3
"""Send a Wake-on-LAN magic packet to wake the desktop (fedora).

Use from the Mac:  ssh laptop wake-desktop

A magic packet is an L2 broadcast, so it must originate on the desktop's LAN
— the laptop (fedora-1) is the intended host because it is always on. The
VPS is not on that LAN and cannot do it.

The desktop must have Wake-on-LAN enabled on both sides: the BIOS (see
deploy/enable-wol.sh, which sets the NIC side) — run that script once on the
desktop with sudo.

No root needed here: this only *sends* a UDP broadcast, which is
unprivileged.

Install on the laptop (fedora-1), once:

    install -m 755 deploy/wake-desktop ~/.local/bin/wake-desktop
"""
import fcntl
import socket
import struct
import sys

# The desktop's wired NIC (fedora's enp9s0). If this ever changes, the MAC
# guard in deploy/enable-wol.sh flags the mismatch.
DESKTOP_MAC = "fc:9d:05:05:cb:84"
WOL_PORT = 9


def magic_packet(mac: str) -> bytes:
    """Six 0xff bytes followed by the MAC repeated sixteen times."""
    octets = bytes.fromhex(mac.replace(":", ""))
    return b"\xff" * 6 + octets * 16


def lan_broadcast(sock: socket.socket) -> str:
    """Broadcast address of the interface owning the default route."""
    with open("/proc/net/route", "rb") as routes:
        for line in routes.readlines()[1:]:
            fields = line.split()
            if len(fields) >= 3 and fields[1] == b"00000000":
                iface = fields[0].decode()
                break
        else:
            return "255.255.255.255"
    # SIOCGIFBRDADDR (0x8919) fills in the broadcast address for the ifname.
    request = fcntl.ioctl(sock.fileno(), 0x8919, struct.pack("256s", iface.encode()[:15]))
    return socket.inet_ntoa(request[20:24])


def main() -> int:
    packet = magic_packet(DESKTOP_MAC)
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        targets = dict.fromkeys(["255.255.255.255", lan_broadcast(sock)])
        for target in targets:
            sock.sendto(packet, (target, WOL_PORT))
            print(f"sent magic packet for {DESKTOP_MAC} to {target}:{WOL_PORT}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
