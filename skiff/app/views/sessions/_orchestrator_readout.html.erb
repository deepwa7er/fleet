<%# The orchestrator readout (M4): the extension's mode as last recorded in
    the session file, the key that flips it, and — while the live process
    holds the extension's widget (plan steps and worker progress, published
    fire-and-forget) — the widget rendered verbatim below the row. Replaced
    by the stream's orchestrator events. The element id is the turbo-stream
    replace target. Locals: orchestrator_active, orchestrator_widget,
    session_id. %>
<div id="orchestrator-readout">
  <span class="instrumentation orchestrator-tag <%= "orchestrator-tag--on" if orchestrator_active %>">
    orchestrator <%= orchestrator_active ? "on" : "off" %>
  </span>
  <%= button_to (orchestrator_active ? "Turn off" : "Turn on"),
        session_orchestrator_path(session_id),
        params: { on: orchestrator_active ? "0" : "1" },
        class: "button button--small button--secondary" %>
  <% if orchestrator_widget.present? %>
    <pre class="orchestrator-widget"><%= orchestrator_widget.join("\n") %></pre>
  <% end %>
</div>
