<% flash.each do |type, message| %>
  <p class="flash flash--<%= type %>"><%= message %></p>
<% end %>

<main class="measure">
  <% if @error %>
    <p class="instrumentation instrumentation--danger"><%= @error %></p>
  <% else %>
    <%# A harness the bridge could not reach (opencode serve down, say) is a
        named gap, not a silent one — the rest of the list still renders. %>
    <% @harness_errors.each do |harness, _message| %>
      <p class="instrumentation instrumentation--danger"><%= harness %> unreachable — its sessions are not listed</p>
    <% end %>

    <p class="instrumentation"><%= pluralize(@sessions.length, "session") %></p>

    <% if @sessions.empty? %>
      <p class="prose">No sessions yet. Your first message starts one.</p>
    <% else %>
      <ul class="list">
        <% @sessions.each do |session| %>
          <li class="item">
            <%= link_to session_title(session), session_path(session[:id]), class: "item-title" %>
            <% if (instrumentation = session_instrumentation(session)).present? %>
              <p class="instrumentation"><%= instrumentation %></p>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</main>

<%# One key per harness, sharing the tray's single row (rule 2: depth marks
    the pressable keys; the row splits the same column the single key used). %>
<nav class="action-bar" aria-label="Session actions">
  <div class="action-bar-row">
    <%= button_to "New pi", sessions_path, params: { harness: "pi" }, class: "button" %>
    <%= button_to "New muse", sessions_path, params: { harness: "muse" }, class: "button" %>
    <%= button_to "New opencode", sessions_path, params: { harness: "opencode" }, class: "button" %>
  </div>
</nav>
<div class="action-bar-spacer" aria-hidden="true"></div>
