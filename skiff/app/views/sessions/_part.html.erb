<%# DW-001 §8: one part of a message. Control parts (step-start/step-finish)
    and anything unknown render nothing; synthetic text parts (auto-attached
    context) are dropped; text parts stream in M4, so the partial must tolerate
    partial text (render_markdown handles blank). Locals: part, message_index,
    part_index (the part's index within its message — together they are the
    reasoning disclosure's stable identity, see below), streaming (the message
    is the live overlay: reasoning renders open so the thinking is readable as
    it streams). %>
<% case part[:type] %>
<% when "text" %>
  <% unless part[:synthetic] %>
    <div class="prose"><%= render_markdown(part[:text]) %></div>
  <% end %>
<% when "reasoning" %>
  <%# The disclosure's stable identity across the stream's whole-message
      replaces (card #110, reasoning_state_controller.js): message index +
      part index. It cannot be the part id — the live overlay's entry id is
      "<pending>", and settlement swaps in the real id, so part ids change
      exactly at the transition the disclosure must survive. The positional
      key is the same before and after settlement, so the controller can
      keep a streamed-open disclosure open when its reply settles. %>
  <details class="reasoning" data-reasoning-state-key="<%= message_index %>:<%= part_index %>"<%= " open" if streaming %>>
    <summary class="instrumentation">reasoning</summary>
    <div class="prose"><%= render_markdown(part[:text]) %></div>
  </details>
<% when "tool" %>
  <% pieces = [ part[:tool], part.dig(:state, :status) ] %>
  <% pieces << part.dig(:state, :title) if part.dig(:state, :title).present? %>
  <p class="instrumentation tool-line <%= "tool-line--bad" if tool_line_bad?(part) %>">
    <%= pieces.compact.join(" · ") %>
  </p>
<% when "file" %>
  <p class="instrumentation tool-line"><%= [ "file", part[:filename] ].compact.join(" · ") %></p>
<% end %>
