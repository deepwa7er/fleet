<%# DW-001 §8: one message block in the transcript. The gap between blocks is
    the divider (rule 1) — no border anywhere. The wrapper carries a stable id
    for M4's stream and the mine marker the user-jump widget hops between
    (present only on the reader's own messages); the role label is the persona
    readout (you / opencode), never the raw role literal. Locals: message (the
    info hash), parts (the parts array), message_index (0-based,
    chronological). %>
<% mine = message[:role] == "user" %>
<section <%= tag.attributes(class: "message", id: "message-#{message_index}", data: { mine: mine || nil }) %>>
  <% role = mine ? "you" : "opencode" %>
  <% agent = message[:role] == "user" ? nil : message[:agent] %>
  <% label = [ role, agent ].compact.join(" · ") %>
  <p class="instrumentation message-role"><%= label %></p>

  <%# The live overlay is the only assistant message without time.completed
      (see session-store.js mapMessageEntry). Its reasoning renders open so
      the thinking is visible while it streams; a settled message renders
      closed, and the user opens it on tap. %>
  <% streaming = message[:role] == "assistant" && message.dig(:time, :completed).nil? %>
  <% parts.each do |part| %>
    <%= render "sessions/part", part: part, message_index: message_index, streaming: streaming %>
  <% end %>
</section>
