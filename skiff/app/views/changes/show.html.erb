<% flash.each do |type, message| %>
  <p class="flash flash--<%= type %>"><%= message %></p>
<% end %>

<main class="measure">
  <p><%= link_to "Desk", root_path, class: "back-link" %></p>

  <% if @error %>
    <p class="instrumentation instrumentation--danger"><%= @error %></p>
  <% else %>
    <% rounds = Array(@change[:rounds]) %>
    <% latest = rounds.last %>

    <%# The header above the code (DW-002 §5): what this is, and the agent's
        report carried as a claim, labelled as one — "agent ran", never a
        verdict. Nothing here checked anything. %>
    <h2 class="session-title"><%= change_title(@change) %></h2>
    <p class="instrumentation"><%= change_instrumentation(@change) %></p>
    <% if latest %>
      <% if (claims = round_claims(latest)) %>
        <p class="instrumentation"><%= claims %></p>
      <% end %>
      <% if Array(latest[:worthKnowing]).any? %>
        <div class="worth-knowing">
          <p class="instrumentation">worth knowing</p>
          <ul>
            <% latest[:worthKnowing].each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>

    <%# Landing outcomes read out where the header is — the state line above
        already says "landing"; these carry the reason when a landing came
        back, and the card-comment gap after one landed. %>
    <% if (landing = @change[:lastLanding]) && !landing[:ok] %>
      <p class="instrumentation instrumentation--danger">landing failed — <%= landing[:reason] %></p>
    <% end %>
    <% if (comment = @change[:cardComment]) && !comment[:ok] %>
      <p class="instrumentation instrumentation--danger">landed, but the card comment failed — <%= comment[:message] %></p>
    <% end %>

    <%# The poll (DW-002 §6: round n+1 appears in place, approve's outcome
        follows). Mounted only while the page can go stale on its own — an
        agent working, or a landing in flight. It reloads whole; the view
        renders ops, it never diffs. %>
    <% poll = %w[working landing].include?(@change[:state]) %>
    <div <% if poll %>data-controller="change-poll"
         data-change-poll-url-value="<%= change_status_path(@change[:repo], @change[:card]) %>"
         data-change-poll-state-value="<%= @change[:state] %>"
         data-change-poll-rounds-value="<%= rounds.length %>"<% end %>>

      <% if rounds.any? %>
        <%# Two views fall out for free (DW-002 §4): this round's diff, and
            the cumulative diff. The current one is a fact, not a key. %>
        <nav class="round-nav instrumentation" aria-label="Rounds">
          <% rounds.each do |round| %>
            <% if @round && round[:n] == @round[:n] %>
              <span class="round-nav-current">round <%= round[:n] %></span>
            <% else %>
              <%= link_to "round #{round[:n]}", change_path(@change[:repo], @change[:card], round: round[:n]) %>
            <% end %>
          <% end %>
          <% if @round.nil? %>
            <span class="round-nav-current">cumulative</span>
          <% else %>
            <%= link_to "cumulative", change_path(@change[:repo], @change[:card], round: "all") %>
          <% end %>
        </nav>
        <% if @round && (@round[:note].present? || @round[:author] == "you") %>
          <p class="instrumentation">round <%= @round[:n] %> · <%= @round[:author] %><%= " · #{@round[:note]}" if @round[:note].present? %></p>
        <% end %>

        <%# The annotated change (§5): the code itself, with the agent's
            justifications at the point they apply. Annotations render only
            in a round view — they are positioned in that round's diff. %>
        <% lookup, stranded = place_annotations(@round, @diff_files) %>
        <% if @diff_files.empty? %>
          <p class="instrumentation">the diff is empty</p>
        <% end %>
        <% @diff_files.each do |file| %>
          <section class="diff-file">
            <p class="diff-file-header instrumentation"><%= file.label %></p>
            <% if file.binary %>
              <p class="instrumentation">binary file</p>
            <% end %>
            <div class="diff-scroll">
              <% file.hunks.each do |hunk| %>
                <p class="diff-hunk-header"><%= hunk.header %></p>
                <% hunk.lines.each do |line| %>
                  <div class="diff-line diff-line--<%= line.kind %>">
                    <span class="diff-gutter"><%= line.old_number %></span>
                    <span class="diff-gutter"><%= line.new_number %></span>
                    <span class="diff-text"><%= line.text %></span>
                  </div>
                  <% annotations_at(lookup, file, line).each do |annotation| %>
                    <aside class="annotation"><%= annotation[:text] %></aside>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </section>
        <% end %>
        <% if stranded.any? %>
          <section class="diff-file">
            <p class="instrumentation instrumentation--danger">annotations whose lines this diff no longer shows</p>
            <% stranded.each do |annotation| %>
              <aside class="annotation"><span class="instrumentation"><%= annotation[:path] %>:<%= annotation[:line] %></span> <%= annotation[:text] %></aside>
            <% end %>
          </section>
        <% end %>
      <% else %>
        <p class="prose">No rounds yet — the agent has not finished its first pass.</p>
      <% end %>
    </div>

    <%# The three verbs (§5), rendered only when the change is actually
        blocking on you. The state line above explains their absence
        otherwise — controls are real actions, never decoration. %>
    <% if @change[:state] == "in_review" %>
      <section class="verbs">
        <%= button_to "Approve — rebase onto main and push", approve_change_path(@change[:repo], @change[:card]), class: "button" %>

        <%= form_with url: request_changes_change_path(@change[:repo], @change[:card]), class: "request-form",
              data: { controller: "composer", action: "submit->composer#disableDuringSubmit" } do |form| %>
          <textarea
            name="note"
            rows="1"
            placeholder="Request changes — it returns as the next round…"
            aria-label="Request changes"
            autocomplete="off"
            data-composer-target="input"
            data-action="keydown->composer#submitOnEnter input->composer#autoGrow"
          ></textarea>
          <button type="submit" class="button button--secondary" data-composer-target="submit">Send</button>
        <% end %>

        <%# Verb three: edit it yourself. The one place a filesystem path is
            allowed to surface (§5/§9) — the browser launches nothing; you
            open the path in the editor you already have. Your commit lands
            as a round authored by you. %>
        <details class="rename">
          <summary class="button button--small button--secondary">Edit it yourself</summary>
          <div class="rename-form">
            <p class="instrumentation">the change is checked out at</p>
            <p class="edit-path"><%= @change[:path] %></p>
            <p class="prose">Open it in your editor; your commit returns here as a round authored by you.</p>
          </div>
        </details>
      </section>
    <% end %>

    <%# The loop closes in one view (§6): the bound session's live
        transcript, streaming under the review. Request changes above, watch
        here, and the poll swaps the new round in when it lands. %>
    <% if @session %>
      <section class="register">
        <p class="instrumentation">the session · <%= session_title(@session) %></p>
        <div data-controller="stream chat-scroll" data-stream-url="<%= session_stream_path(@session[:id]) %>">
          <%= render "sessions/status", working: false, session_id: @session[:id] %>
          <%= render "sessions/transcript", messages: Array(@messages), harness: @session[:harness] %>
        </div>
      </section>
    <% end %>
  <% end %>
</main>
