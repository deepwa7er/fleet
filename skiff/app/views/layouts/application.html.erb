<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Skiff" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Skiff">
    <meta name="application-name" content="Skiff">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# PWA: the manifest makes the app installable; the theme-color metas
        carry both schemes (the manifest itself is static, so it holds the
        paper base — the light discipline, DW-001 §2). The service worker is
        registered from app/javascript/application.js. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#f7f2e9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121316" media="(prefers-color-scheme: dark)">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="container">
      <%# G11/G5 masthead: the app title is the incipit of this page. DW-001
          §7: a page never says its title twice — on home the masthead IS the
          h1, so the page renders no heading of its own. %>
      <header class="masthead">
        <h1 class="masthead-title">Skiff</h1>
      </header>

      <%= yield %>
    </div>
  </body>
</html>
