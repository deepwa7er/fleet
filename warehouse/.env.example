# Copy to .env and fill in. Never commit .env.
# Warehouse location on Fedora desktop (local durability)
WAREHOUSE_DIR=/home/deepwater/data/warehouse
WAREHOUSE_DB=/home/deepwater/data/warehouse/warehouse.sqlite
WAREHOUSE_RAW_DIR=/home/deepwater/data/warehouse/raw

# Code to index
CODE_ROOT=/home/deepwater/code
SHELL_HISTORY=/home/deepwater/.bash_history

# R2 (S3-compatible) - disaster recovery target
# Leave placeholder until you create bucket. Ingest works without R2; backup will error clearly if unset.
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=deepwa7er-fleet-backup
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional prefix within bucket
R2_PREFIX=warehouse/

# Ingest knobs
INGEST_GIT_COMMITS_PER_REPO=100
