<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for `atlas serve` on the dev box.

  This is a TEMPLATE. Copy it to ~/Library/LaunchAgents/, replace the __…__
  placeholders, then load it (`launchctl load -w …`). See the README.

  Like source's agent, it launches through a login fish shell so the daemon
  inherits the same PATH/toolchain (cargo, rust-analyzer, git) that interactive
  use has, rather than launchd's bare default PATH — atlas shells out to
  rust-analyzer on every re-index, so the toolchain PATH is load-bearing here.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.deepwa7er.atlas</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/fish</string>
    <string>-l</string>
    <string>-c</string>
    <string>exec __HOME__/.cargo/bin/atlas serve --config __HOME__/code/fleet/atlas/atlas.toml</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/atlas.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/atlas.log</string>
</dict>
</plist>
