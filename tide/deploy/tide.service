[Unit]
Description=tide — fleet-wide settings (shared theme)
Documentation=https://github.com/deepwa7er/tide
# Order after tailscaled so the network is up before we bind.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=tide
Group=tide
ExecStart=/usr/local/bin/tide serve --config /etc/tide/config.toml
Restart=on-failure
RestartSec=2

# systemd creates /var/lib/tide owned by the service user and makes it writable
# even under ProtectSystem=strict — this is where settings.json lives.
StateDirectory=tide

# Hardening — tide only reads its config and writes its one settings file.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
