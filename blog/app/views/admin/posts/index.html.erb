<% content_for :title, "Admin" %>

<div class="page-header">
  <h1>Posts</h1>
  <a class="button" href="<%= new_admin_post_path %>">New post</a>
</div>

<% if @drafts.any? %>
  <h2>Drafts</h2>
  <ol class="posts">
    <% @drafts.each do |post| %>
      <li class="post-item">
        <a class="post-item-title" href="<%= admin_post_path(post) %>"><%= post.title %></a>
        <p class="meta">Edited <%= post.updated_at.strftime("%d %b %Y").upcase %></p>
      </li>
    <% end %>
  </ol>
<% end %>

<h2>Published</h2>
<% if @posts.any? %>
  <ol class="posts">
    <% @posts.each do |post| %>
      <li class="post-item">
        <a class="post-item-title" href="<%= admin_post_path(post) %>"><%= post.title %></a>
        <p class="meta">
          <%= post.published_at.strftime("%d %b %Y").upcase %>
          <% if post.scheduled? %>· <%= post_state(post) %><% end %>
        </p>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="empty-state">Nothing published yet.</p>
<% end %>
