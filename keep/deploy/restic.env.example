# Restic repository + credentials for keep's self-backup.
# Install as /etc/keep/restic.env on OVH, mode 600, owned by root:
#   sudo install -m600 /dev/stdin /etc/keep/restic.env <<'EOF'
#   ...filled-in contents...
#   EOF
# then `systemctl restart keep`. Same contract as fleet-backup's restic.env;
# a DIFFERENT repository (or at minimum a distinct path) from fleet-backup's,
# so the two systems' forget policies never meet.
#
# Backend is Cloudflare R2 (S3-compatible). Create a bucket and an R2 API token
# (Object Read & Write) in the Cloudflare dashboard, then fill these in.

# s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET_NAME>
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>

# The repository encryption passphrase. Generate a strong one and SAVE IT IN
# YOUR PASSWORD MANAGER — if this is lost, the backups are UNRECOVERABLE, even
# with the R2 credentials. (e.g. `openssl rand -base64 24`)
RESTIC_PASSWORD=<long-random-passphrase>

# Your Cloudflare R2 API token. The variable NAMES must be AWS_* — that's simply
# what restic's S3 backend reads for ANY S3-compatible store (R2, B2, MinIO, …);
# it's a tooling convention, not actual AWS. The VALUES are your R2 token.
AWS_ACCESS_KEY_ID=<r2 access key id>
AWS_SECRET_ACCESS_KEY=<r2 secret access key>
# R2 ignores region, but the S3 client requires one to be set; `auto` is correct.
AWS_DEFAULT_REGION=auto
