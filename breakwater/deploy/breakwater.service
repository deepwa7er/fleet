[Unit]
Description=breakwater tailnet reverse proxy
Documentation=https://github.com/deepwa7er/breakwater
# Order after tailscaled so the Tailscale interface/IP exists before we bind it,
# and after the network is online for outbound ACME/DNS during issuance.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=breakwater
Group=breakwater
ExecStart=/usr/local/bin/breakwater /etc/breakwater/breakwater.toml
Restart=on-failure
RestartSec=5

# Bind :443 and :80 (privileged ports) as an unprivileged user. systemd grants
# this ambient capability across the user switch; nothing else is permitted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Writable state: the ACME account key and issued cert/key cache. systemd creates
# /var/lib/breakwater owned by the service user and adds it to ReadWritePaths.
StateDirectory=breakwater
StateDirectoryMode=0750

# Hardening — breakwater terminates TLS, proxies, and writes only its cert cache.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
