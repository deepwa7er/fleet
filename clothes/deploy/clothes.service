[Unit]
Description=Clothes wardrobe organizer
Documentation=https://github.com/deepwa7er/clothes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clothes
Group=clothes
# Creates /var/lib/clothes (owned by clothes, writable under ProtectSystem=strict)
# where the SQLite database lives — and which fleet-backup ships to R2.
StateDirectory=clothes
Environment=CLOTHES_DB=/var/lib/clothes/clothes.db
Environment=CLOTHES_ADDR=127.0.0.1:8099
Environment=CLOTHES_WEB_DIR=/opt/clothes/web
ExecStart=/usr/local/bin/clothes serve
Restart=on-failure
RestartSec=2

# Hardening — the service only reads its web dir and writes its state dir, and
# makes outbound HTTP for best-effort link-metadata fetches.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
